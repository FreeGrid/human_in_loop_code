{
  "name": "@baochunli/pi-collaborating-agents",
  "version": "0.4.6",
  "description": "Collaborative multi-agent messaging and remote focus overlay extension for Pi",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*",
    "extensions/*"
  ],
  "scripts": {
    "install:frozen": "BUN_INSTALL_CACHE_DIR=.harness-tmp/bun-install-cache bun install --frozen-lockfile",
    "build": "bun run typecheck",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "bun test",
    "package:dry-run": "npm_config_cache=.harness-tmp/npm-cache npm pack --dry-run",
    "clean": "bun ./scripts/clean.ts",
    "verify:code": "bun run build && bun run test && bun run package:dry-run"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.9.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/baochunli/pi-collaborating-agents.git"
  },
  "homepage": "https://github.com/baochunli/pi-collaborating-agents#readme",
  "bugs": {
    "url": "https://github.com/baochunli/pi-collaborating-agents/issues"
  },
  "keywords": [
    "pi-package"
  ],
  "peerDependencies": {
    "@mariozechner/pi-ai": "*",
    "@mariozechner/pi-coding-agent": "*",
    "@mariozechner/pi-tui": "*",
    "@sinclair/typebox": "*"
  },
  "files": [
    "extensions/collaborating-agents/**/*",
    "extensions/research-harness/**/*",
    "skills/collaborating-agents-system/**/*",
    "examples/subagents/**/*",
    "packages/config/**/*",
    "packages/controller-client/**/*",
    "packages/controller-core/**/*",
    "packages/prompt-runtime/**/*",
    "packages/schemas/**/*",
    "templates/research-three-repo/**/*",
    "docs/repository-layout.md",
    "docs/development-commands.md",
    "README.md",
    "CHANGELOG",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "pi": {
    "extensions": [
      "./extensions/collaborating-agents/index.ts"
    ],
    "skills": [
      "./skills"
    ]
  }
}
